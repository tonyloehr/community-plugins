        {
          "ruleId": "business_data_gap",
          "comparison": "ERROR",
          "operationId": "grafana.business.operational.kpi",
          "issueKind": "EVIDENCE_GAP",
          "severity": "WARNING",
          "signedThreshold": false
        }
      ],
      "definitionSha256": "f11f3b48a6eb198725c937b2cefc1c2a04cd9c551fa039b6478366a0acb2c1fc"
    }
  ]
}
