    overall: { enum: ["COMPLETE", "PARTIAL", "UNKNOWN"] },
    entries: { type: "array", maxItems: 1024, items: { type: "object", additionalProperties: false, required: ["domain", "operationId", "requirement", "disposition", "evidenceIds", "contradictionIds", "blocksWorkflow"], properties: { domain: { $ref: "urn:production-monitoring:schema:common:1#/$defs/EvidenceDomain" }, operationId: { $ref: "urn:production-monitoring:schema:common:1#/$defs/OperationId" }, requirement: { enum: ["REQUIRED", "OPTIONAL"] }, sourceAlias: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Alias" }, authority: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Authority" }, disposition: { enum: ["AVAILABLE", "EMPTY", "STALE", "CONTRADICTORY", "ERROR", "UNSUPPORTED", "DEFERRED"] }, evidenceIds: { type: "array", uniqueItems: true, items: { $ref: "urn:production-monitoring:schema:common:1#/$defs/EvidenceId" } }, contradictionIds: { type: "array", uniqueItems: true, items: { $ref: "urn:production-monitoring:schema:common:1#/$defs/ContradictionId" } }, paginationComplete: { type: "boolean" }, blocksWorkflow: { type: "boolean" }, reason: { type: "string", minLength: 1, maxLength: 2048 } } } },
    integrity: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Integrity" }
  }
};

// packages/contracts/schemas/evidence-envelope.schema.json
var evidence_envelope_schema_default = {
  $schema: "https://json-schema.org/draft/2020-12/schema",
  $id: "urn:production-monitoring:schema:evidence-envelope:1",
  title: "Normalized evidence envelope",
  type: "object",
  additionalProperties: false,
  required: ["schemaVersion", "evidenceId", "runId", "operationId", "operationDefinitionSha256", "trustBundleSha256", "origin", "authority", "source", "scope", "correlation", "evaluatedAt", "collectedAt", "window", "maxAcceptableAgeMs", "collectionState", "freshnessState", "native", "values", "redactions", "limitations", "pagination", "providerWarnings", "integrity"],
  properties: {
    schemaVersion: { enum: ["1.0.0", "1.1.0"] },
    evidenceId: { $ref: "urn:production-monitoring:schema:common:1#/$defs/EvidenceId" },
    runId: { $ref: "urn:production-monitoring:schema:common:1#/$defs/RunId" },
    operationId: { $ref: "urn:production-monitoring:schema:common:1#/$defs/OperationId" },
    operationDefinitionSha256: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Sha256" },
    trustBundleSha256: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Sha256" },
    origin: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Origin" },
    authority: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Authority" },
    source: {
      type: "object",
      additionalProperties: false,
      required: ["provider", "sourceAlias", "adapterPackageId", "adapterVersion"],
      properties: {
        provider: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Alias" },
        sourceAlias: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Alias" },
        adapterPackageId: { $ref: "urn:production-monitoring:schema:common:1#/$defs/AdapterPackageId" },
        adapterVersion: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Semver" },
        sanitizedReference: { type: "string", minLength: 1, maxLength: 2048 },
        lineage: {
          type: "object",
          additionalProperties: false,
          required: ["accessPath", "datasourceType", "sourceIdentitySha256"],
          properties: {
            accessPath: { enum: ["DIRECT", "GRAFANA"] },
            datasourceType: { enum: ["prometheus", "loki", "tempo", "postgres"] },
            sourceIdentitySha256: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Sha256" }
          }
        }
      }
    },
    scope: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Scope" },
    correlation: { $ref: "urn:production-monitoring:schema:common:1#/$defs/CorrelationIdentity" },
    evaluatedAt: { type: "string", format: "date-time" },
    collectedAt: { type: "string", format: "date-time" },
    window: { $ref: "urn:production-monitoring:schema:common:1#/$defs/TimeWindow" },
    maxAcceptableAgeMs: { type: "integer", minimum: 0, maximum: 31536e6 },
    collectionState: { enum: ["COMPLETE", "EMPTY", "ERROR"] },
    freshnessState: { enum: ["FRESH", "STALE", "NOT_APPLICABLE"] },
    native: { type: "object", additionalProperties: false, required: ["resultType", "dimensions"], properties: { resultType: { type: "string", minLength: 1, maxLength: 128 }, unit: { type: "string", minLength: 1, maxLength: 64 }, dimensions: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Dimensions" } } },
    values: { type: "array", maxItems: 1e4, items: { $ref: "urn:production-monitoring:schema:common:1#/$defs/NormalizedValue" } },
    redactions: { type: "array", maxItems: 1e4, items: { $ref: "urn:production-monitoring:schema:common:1#/$defs/RedactionRecord" } },
    limitations: { type: "array", maxItems: 256, items: { type: "string", minLength: 1, maxLength: 2048 } },
    pagination: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Pagination" },
    providerWarnings: { type: "array", maxItems: 256, items: { type: "string", minLength: 1, maxLength: 2048 } },
    error: { $ref: "urn:production-monitoring:schema:common:1#/$defs/SanitizedError" },
    integrity: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Integrity" }
  },
  oneOf: [
    { properties: { collectionState: { const: "COMPLETE" }, freshnessState: { enum: ["FRESH", "STALE"] }, values: { type: "array", minItems: 1 } }, required: ["collectionState", "freshnessState", "values"], not: { properties: { error: true }, required: ["error"] } },
    { properties: { collectionState: { const: "EMPTY" }, freshnessState: { enum: ["FRESH", "STALE"] }, values: { type: "array", maxItems: 0 } }, required: ["collectionState", "freshnessState", "values"], not: { properties: { error: true }, required: ["error"] } },
    { properties: { collectionState: { const: "ERROR" }, freshnessState: { const: "NOT_APPLICABLE" }, values: { type: "array", maxItems: 0 }, error: { $ref: "urn:production-monitoring:schema:common:1#/$defs/SanitizedError" } }, required: ["collectionState", "freshnessState", "values", "error"] }
  ],
  allOf: [
    {
      if: { properties: { schemaVersion: { const: "1.1.0" } }, required: ["schemaVersion"] },
      then: {
        properties: {
          source: {
            type: "object",
            properties: { lineage: {} },
            required: ["lineage"]
          }
        }
      },
      else: {
        properties: {
          source: {
            type: "object",
            not: {
              type: "object",
              properties: { lineage: {} },
              required: ["lineage"]
            }
          }
        }
      }
    }
  ],
  $comment: "Cross-source consistency is not asserted here. Contradictions are separate records; the five-state evidence view is derived."
};

// packages/contracts/schemas/evidence-link.schema.json
var evidence_link_schema_default = {
  $schema: "https://json-schema.org/draft/2020-12/schema",
  $id: "urn:production-monitoring:schema:evidence-link:1",
  title: "Opaque workbench evidence link",
  type: "object",
  additionalProperties: false,
  required: [
    "schemaVersion",
    "workspaceId",
    "linkRef",
    "kind",
    "label",
    "availability"
  ],
  properties: {
    schemaVersion: { const: "1.0.0" },
    workspaceId: {
      $ref: "urn:production-monitoring:schema:common:1#/$defs/MonitoringWorkspaceId"
    },
    linkRef: {
      $ref: "urn:production-monitoring:schema:common:1#/$defs/WorkbenchLinkRef"
    },
    evidenceRef: {
      $ref: "urn:production-monitoring:schema:common:1#/$defs/WorkbenchEvidenceRef"
    },
    kind: {
      enum: [
        "GRAFANA_DASHBOARD",
        "GRAFANA_PANEL",
        "PROMETHEUS_VIEW",
        "LOG_VIEW",
        "TRACE_VIEW",
        "CODE_REVISION",
        "CODE_LOCATION"
      ]
    },
    label: { type: "string", minLength: 1, maxLength: 96 },
    availability: { enum: ["AVAILABLE", "UNAVAILABLE"] },
    unavailableReason: { type: "string", minLength: 1, maxLength: 256 }
  },
  allOf: [
    {
      if: {
        properties: { availability: { const: "UNAVAILABLE" } },
        required: ["availability"]
      },
      then: {
        required: ["unavailableReason"],
        properties: {
          unavailableReason: { type: "string", minLength: 1, maxLength: 256 }
        }
      }
    }
  ]
};

// packages/contracts/schemas/investigation.schema.json
var investigation_schema_default = {
  $schema: "https://json-schema.org/draft/2020-12/schema",
  $id: "urn:production-monitoring:schema:investigation:1",
  title: "Evidence-linked investigation",
  type: "object",
  additionalProperties: false,
  required: ["schemaVersion", "runId", "analysisState", "status", "recoveryState", "scope", "requestedWindow", "evaluatedWindow", "observations", "inferences", "hypotheses", "contradictionIds", "checksPerformed", "missingEvidence", "smallestSafeNextStep", "approvalRequired", "remainingUncertainty", "owners", "integrity"],
  properties: {
    schemaVersion: { const: "1.0.0" },
    runId: { $ref: "urn:production-monitoring:schema:common:1#/$defs/RunId" },
    analysisState: { enum: ["SUBMITTED", "EVIDENCE_ONLY"] },
    status: { $ref: "urn:production-monitoring:schema:common:1#/$defs/InvestigationStatus" },
    recoveryState: { $ref: "urn:production-monitoring:schema:common:1#/$defs/RecoveryState" },
    scope: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Scope" },
    requestedWindow: { $ref: "urn:production-monitoring:schema:common:1#/$defs/TimeWindow" },
    evaluatedWindow: { $ref: "urn:production-monitoring:schema:common:1#/$defs/TimeWindow" },
    observations: { type: "array", maxItems: 1e3, items: { $ref: "#/$defs/observation" } },
    inferences: { type: "array", maxItems: 1e3, items: { $ref: "#/$defs/inference" } },
    hypotheses: { type: "array", maxItems: 256, items: { $ref: "#/$defs/hypothesis" } },
    contradictionIds: { type: "array", uniqueItems: true, items: { $ref: "urn:production-monitoring:schema:common:1#/$defs/ContradictionId" } },
    checksPerformed: { $ref: "#/$defs/stringList" },
    missingEvidence: { $ref: "#/$defs/stringList" },
    smallestSafeNextStep: { type: "string", minLength: 1, maxLength: 4096 },
    approvalRequired: { type: "boolean" },
    verificationContract: { $ref: "#/$defs/verificationContract" },
    verificationResult: { type: "object", additionalProperties: false, required: ["status", "evidenceIds"], properties: { status: { enum: ["PASSED", "FAILED", "INCOMPLETE"] }, evidenceIds: { type: "array", uniqueItems: true, items: { $ref: "urn:production-monitoring:schema:common:1#/$defs/EvidenceId" } } } },
    remainingUncertainty: { $ref: "#/$defs/stringList" },
    owners: { $ref: "#/$defs/stringList" },
    integrity: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Integrity" }
  },
  $defs: {
    stringList: { type: "array", maxItems: 256, items: { type: "string", minLength: 1, maxLength: 4096 } },
    evidenceIds: { type: "array", maxItems: 128, uniqueItems: true, items: { $ref: "urn:production-monitoring:schema:common:1#/$defs/EvidenceId" } },
    observation: { type: "object", additionalProperties: false, required: ["observationId", "statement", "evidenceIds"], properties: { observationId: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Alias" }, statement: { type: "string", minLength: 1, maxLength: 4096 }, evidenceIds: { type: "array", minItems: 1, maxItems: 128, uniqueItems: true, items: { $ref: "urn:production-monitoring:schema:common:1#/$defs/EvidenceId" } } } },
    inference: { type: "object", additionalProperties: false, required: ["inferenceId", "statement", "confidence", "rationale", "supportingEvidenceIds", "contradictingEvidenceIds"], properties: { inferenceId: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Alias" }, statement: { type: "string", minLength: 1, maxLength: 4096 }, confidence: { type: "number", minimum: 0, maximum: 1 }, rationale: { type: "string", minLength: 1, maxLength: 4096 }, supportingEvidenceIds: { $ref: "#/$defs/supportingEvidenceIds" }, contradictingEvidenceIds: { $ref: "#/$defs/evidenceIds" } } },
    hypothesis: { type: "object", additionalProperties: false, required: ["hypothesisId", "rank", "statement", "status", "rationale", "supportingEvidenceIds", "contradictingEvidenceIds"], properties: { hypothesisId: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Alias" }, rank: { type: "integer", minimum: 1 }, statement: { type: "string", minLength: 1, maxLength: 4096 }, status: { enum: ["OPEN", "SUPPORTED", "WEAKENED", "REJECTED"] }, rationale: { type: "string", minLength: 1, maxLength: 4096 }, supportingEvidenceIds: { $ref: "#/$defs/supportingEvidenceIds" }, contradictingEvidenceIds: { $ref: "#/$defs/evidenceIds" }, nextCheck: { type: "string", minLength: 1, maxLength: 4096 } } },
    verificationContract: { type: "object", additionalProperties: false, required: ["contractSha256", "policyAlias", "scope", "windowStrategy", "windowDurationSeconds", "requiredSamples", "passCount", "criteria"], properties: { contractSha256: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Sha256" }, policyAlias: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Alias" }, scope: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Scope" }, cohort: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Alias" }, windowStrategy: { enum: ["FIXED", "ROLLING", "REPEATED_CHECKS"] }, windowDurationSeconds: { type: "integer", minimum: 1, maximum: 86400 }, requiredSamples: { type: "integer", minimum: 1, maximum: 1e4 }, passCount: { type: "integer", minimum: 1, maximum: 1e4 }, criteria: { type: "array", minItems: 1, maxItems: 128, items: { type: "object", additionalProperties: false, required: ["criterionId", "operationId", "operationDefinitionSha256", "valueSelector", "comparator", "expected", "maxEvidenceAgeMs"], properties: { criterionId: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Alias" }, operationId: { $ref: "urn:production-monitoring:schema:common:1#/$defs/OperationId" }, operationDefinitionSha256: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Sha256" }, valueSelector: { type: "object", additionalProperties: false, required: ["kind", "name", "reducer"], properties: { kind: { enum: ["SCALAR", "TIMESERIES"] }, name: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Alias" }, reducer: { enum: ["SINGLE", "LATEST", "ALL"] }, dimensions: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Dimensions" } } }, comparator: { enum: ["LT", "LTE", "GT", "GTE", "EQ", "INACTIVE", "ACTIVE"] }, expected: { $ref: "urn:production-monitoring:schema:common:1#/$defs/JsonPrimitive" }, unit: { type: "string", minLength: 1, maxLength: 64 }, maxEvidenceAgeMs: { type: "integer", minimum: 0, maximum: 31536e6 }, requiredDurationSeconds: { type: "integer", minimum: 1, maximum: 86400 } } } } } },
    supportingEvidenceIds: { type: "array", minItems: 1, maxItems: 128, uniqueItems: true, items: { $ref: "urn:production-monitoring:schema:common:1#/$defs/EvidenceId" } }
  },
  allOf: [{ if: { properties: { recoveryState: { const: "RECOVERED" } }, required: ["recoveryState"] }, then: { required: ["verificationContract", "verificationResult"], properties: { verificationContract: { $ref: "#/$defs/verificationContract" }, verificationResult: { type: "object", properties: { status: { const: "PASSED" } }, required: ["status"] } } } }]
};

// packages/contracts/schemas/manifest.schema.json
var manifest_schema_default = {
  $schema: "https://json-schema.org/draft/2020-12/schema",
  $id: "urn:production-monitoring:schema:manifest:1",
  title: "Sealed incident bundle manifest",
  type: "object",
  additionalProperties: false,
  required: ["schemaVersion", "bundleId", "runId", "origin", "producer", "createdAt", "sealedAt", "entries", "bundleSha256"],
  properties: {
    schemaVersion: { const: "1.0.0" },
    bundleId: { $ref: "urn:production-monitoring:schema:common:1#/$defs/BundleId" },
    runId: { $ref: "urn:production-monitoring:schema:common:1#/$defs/RunId" },
    parentRunId: { $ref: "urn:production-monitoring:schema:common:1#/$defs/RunId" },
    origin: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Origin" },
    producer: { type: "object", additionalProperties: false, required: ["pluginVersion", "contractsVersion", "reportProjectionVersion"], properties: { pluginVersion: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Semver" }, contractsVersion: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Semver" }, reportProjectionVersion: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Semver" } } },
    createdAt: { type: "string", format: "date-time" },
    sealedAt: { type: "string", format: "date-time" },
    entries: { type: "array", minItems: 1, maxItems: 1e4, items: { type: "object", additionalProperties: false, required: ["path", "role", "mediaType", "bytes", "sha256"], properties: { path: { allOf: [{ $ref: "urn:production-monitoring:schema:common:1#/$defs/PortableRelativePath" }, { not: { enum: ["manifest.json", "manifest.sha256", "manifest.sig", "report.md"] } }] }, role: { enum: ["RUN", "PROFILE", "OPERATIONS", "EVIDENCE", "CONTRADICTIONS", "COVERAGE", "INVESTIGATION", "RECEIPT"] }, mediaType: { type: "string", pattern: "^[a-z0-9.+-]+/[a-z0-9.+-]+$" }, bytes: { type: "integer", minimum: 0 }, sha256: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Sha256" } } } },
    bundleSha256: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Sha256" }
  },
  $comment: "bundleSha256 covers only canonical semantic-file receipts sorted by path. manifest.json, manifest.sha256, manifest.sig, and the derived report.md projection are excluded, avoiding circular or presentation-dependent hashes."
};

// packages/contracts/schemas/monitoring-evidence-detail.schema.json
var monitoring_evidence_detail_schema_default = {
  $schema: "https://json-schema.org/draft/2020-12/schema",
  $id: "urn:production-monitoring:schema:monitoring-evidence-detail:1",
  title: "Bounded workbench evidence detail",
  type: "object",
  additionalProperties: false,
  required: [
    "schemaVersion",
    "workspaceId",
    "evidenceRef",
    "title",
    "domain",
    "origin",
    "authority",
    "state",
    "source",
    "evaluatedAt",
    "collectedAt",
    "window",
    "summary",
    "values",
    "limitations",
    "linkRefs"
  ],
  properties: {
    schemaVersion: { const: "1.0.0" },
    workspaceId: {
      $ref: "urn:production-monitoring:schema:common:1#/$defs/MonitoringWorkspaceId"
    },
    evidenceRef: {
      $ref: "urn:production-monitoring:schema:common:1#/$defs/WorkbenchEvidenceRef"
    },
    title: { type: "string", minLength: 1, maxLength: 160 },
    domain: {
      $ref: "urn:production-monitoring:schema:common:1#/$defs/EvidenceDomain"
    },
    origin: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Origin" },
    authority: {
      $ref: "urn:production-monitoring:schema:common:1#/$defs/Authority"
    },
    state: {
      enum: ["COMPLETE", "EMPTY", "STALE", "CONTRADICTORY", "ERROR"]
    },
    source: {
      type: "object",
      additionalProperties: false,
      required: ["provider", "sourceAlias"],
      properties: {
        provider: {
          type: "string",
          minLength: 1,
          maxLength: 64,
          pattern: "^[a-z][a-z0-9._-]{0,63}$"
        },
        sourceAlias: {
          $ref: "urn:production-monitoring:schema:common:1#/$defs/Alias"
        }
      }
    },
    evaluatedAt: { type: "string", format: "date-time" },
    collectedAt: { type: "string", format: "date-time" },
    window: {
      $ref: "urn:production-monitoring:schema:common:1#/$defs/TimeWindow"
    },
    summary: { type: "string", minLength: 1, maxLength: 1024 },
    values: {
      type: "array",
      maxItems: 24,
      items: {
        oneOf: [
          { $ref: "#/$defs/metric" },
          { $ref: "#/$defs/fact" },
          { $ref: "#/$defs/event" }
        ]
      }
    },
    limitations: {
      type: "array",
      maxItems: 12,
      items: { type: "string", minLength: 1, maxLength: 512 }
    },
    linkRefs: {
      type: "array",
      maxItems: 8,
      uniqueItems: true,
      items: { $ref: "urn:production-monitoring:schema:common:1#/$defs/WorkbenchLinkRef" }
    }
  },
  $defs: {
    metric: {
      type: "object",
      additionalProperties: false,
      required: ["kind", "label", "value", "points"],
      properties: {
        kind: { const: "METRIC" },
        label: { type: "string", minLength: 1, maxLength: 96 },
        value: { type: ["number", "null"] },
        unit: { type: "string", minLength: 1, maxLength: 32 },
        points: {
          type: "array",
          maxItems: 60,
          items: {
            type: "object",
            additionalProperties: false,
            required: ["at", "value"],
            properties: {
              at: { type: "string", format: "date-time" },
              value: { type: ["number", "null"] }
            }
          }
        }
      }
    },
    fact: {
      type: "object",
      additionalProperties: false,
      required: ["kind", "label", "value"],
      properties: {
        kind: { const: "FACT" },
        label: { type: "string", minLength: 1, maxLength: 96 },
        value: { type: ["null", "boolean", "number", "string"], maxLength: 256 }
      }
    },
    event: {
      type: "object",
      additionalProperties: false,
      required: ["kind", "at", "summary"],
      properties: {
        kind: { const: "EVENT" },
        at: { type: "string", format: "date-time" },
        summary: { type: "string", minLength: 1, maxLength: 512 }
      }
    }
  }
};

// packages/contracts/schemas/monitoring-workspace-snapshot.schema.json
var monitoring_workspace_snapshot_schema_default = {
  $schema: "https://json-schema.org/draft/2020-12/schema",
  $id: "urn:production-monitoring:schema:monitoring-workspace-snapshot:1",
  title: "Production Monitoring workbench snapshot",
  type: "object",
  additionalProperties: false,
  required: [
    "schemaVersion",
    "workspaceId",
    "stateVersion",
    "asOf",
    "lifecycle",
    "phase",
    "status",
    "progress",
    "signals",
    "hypotheses",
    "evidence",
    "activity",
    "patch",
    "nextAction",
    "limitations"
  ],
  properties: {
    schemaVersion: { enum: ["1.0.0", "1.1.0"] },
    workspaceId: {
      $ref: "urn:production-monitoring:schema:common:1#/$defs/MonitoringWorkspaceId"
    },
    stateVersion: { type: "integer", minimum: 1, maximum: 9007199254740991 },
    asOf: { type: "string", format: "date-time" },
    lifecycle: {
      enum: ["IDLE", "PREFLIGHT", "RUNNING", "SEALED", "PARTIAL", "BLOCKED", "CANCELLED"]
    },
    phase: {
      enum: [
        "READINESS",
        "SCOPING",
        "BASELINE",
        "COLLECTING",
        "COMPARING",
        "ANALYZING",
        "FINALIZING",
        "PATCHING",
        "VERIFYING"
      ]
    },
    origin: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Origin" },
    scope: {
      type: "object",
      additionalProperties: false,
      required: ["environment"],
      properties: {
        service: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Alias" },
        environment: {
          $ref: "urn:production-monitoring:schema:common:1#/$defs/Alias"
        },
        window: { $ref: "urn:production-monitoring:schema:common:1#/$defs/TimeWindow" }
      }
    },
    status: {
      type: "object",
      additionalProperties: false,
      required: ["service", "collection", "causality", "recovery", "audit"],
      properties: {
        service: { enum: ["HEALTHY", "DEGRADED", "RECOVERING", "UNKNOWN"] },
        collection: {
          enum: ["NOT_STARTED", "IN_PROGRESS", "COMPLETE", "PARTIAL", "ERROR"]
        },
        causality: { enum: ["NOT_ASSESSED", "OPEN", "SUPPORTED", "INCONCLUSIVE"] },
        recovery: {
          enum: [
            "NOT_ASSESSED",
            "APPROVAL_REQUIRED",
            "ACTION_FAILED",
            "INCOMPLETE",
            "NOT_RECOVERED",
            "RECOVERED"
          ]
        },
        audit: { enum: ["INITIALIZING", "HEALTHY", "DEGRADED", "ERROR"] }
      }
    },
    progress: {
      type: "object",
      additionalProperties: false,
      required: ["completedOperations", "requiredOperations", "sourceStates"],
      properties: {
        completedOperations: { type: "integer", minimum: 0, maximum: 1024 },
        requiredOperations: { type: "integer", minimum: 0, maximum: 1024 },
        sourceStates: {
          type: "object",
          maxProperties: 16,
          propertyNames: { pattern: "^[A-Z][A-Z0-9_]{0,31}$" },
          additionalProperties: { type: "integer", minimum: 0, maximum: 1024 }
        }
      }
    },
    signals: {
      type: "array",
      maxItems: 3,
      items: { $ref: "#/$defs/signalCard" }
    },
    hypotheses: {
      type: "array",
      maxItems: 3,
      items: { $ref: "#/$defs/hypothesisCard" }
    },
    issues: {
      type: "array",
      maxItems: 24,
      items: { $ref: "#/$defs/issueCard" }
    },
    evidence: {
      type: "array",
      maxItems: 24,
      items: { $ref: "#/$defs/evidenceCard" }
    },
    activity: {
      type: "array",
      maxItems: 40,
      items: { $ref: "#/$defs/activityItem" }
    },
    patch: { $ref: "urn:production-monitoring:schema:patch-status:1" },
    nextAction: { $ref: "#/$defs/actionAvailability" },
    limitations: {
      type: "array",
      maxItems: 16,
      items: { type: "string", minLength: 1, maxLength: 512 }
    }
  },
  allOf: [
    {
      if: { properties: { schemaVersion: { const: "1.1.0" } }, required: ["schemaVersion"] },
      then: { properties: { issues: {} }, required: ["issues"] },
      else: { not: { required: ["issues"] } }
    }
  ],
  $defs: {
    evidenceRefs: {
      type: "array",
      maxItems: 8,
      uniqueItems: true,
      items: {
        $ref: "urn:production-monitoring:schema:common:1#/$defs/WorkbenchEvidenceRef"
      }
    },
    linkRefs: {
      type: "array",
      maxItems: 4,
      uniqueItems: true,
      items: { $ref: "urn:production-monitoring:schema:common:1#/$defs/WorkbenchLinkRef" }
    },
    signalCard: {
      type: "object",
      additionalProperties: false,
      required: [
        "signalRef",
        "title",
        "displayValue",
        "severity",
        "direction",
        "points",
        "evidenceRefs"
      ],
      properties: {
        signalRef: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Alias" },
        title: { type: "string", minLength: 1, maxLength: 96 },
        displayValue: { type: "string", minLength: 1, maxLength: 64 },
        unit: { type: "string", minLength: 1, maxLength: 32 },
        severity: { enum: ["NEUTRAL", "GOOD", "WARNING", "CRITICAL"] },
        direction: { enum: ["UP", "DOWN", "FLAT", "UNKNOWN"] },
        points: {
          type: "array",
          maxItems: 30,
          items: { type: ["number", "null"] }
        },
        evidenceRefs: { $ref: "#/$defs/evidenceRefs" }
      }
    },
    hypothesisCard: {
      type: "object",
      additionalProperties: false,
      required: [
        "hypothesisRef",
        "rank",
        "statement",
        "status",
        "rationale",
        "evidenceRefs"
      ],
      properties: {
        hypothesisRef: {
          $ref: "urn:production-monitoring:schema:common:1#/$defs/Alias"
        },
        rank: { type: "integer", minimum: 1, maximum: 3 },
        statement: { type: "string", minLength: 1, maxLength: 512 },
        status: { enum: ["OPEN", "SUPPORTED", "WEAKENED", "REJECTED"] },
        confidence: { type: "number", minimum: 0, maximum: 1 },
        rationale: { type: "string", minLength: 1, maxLength: 512 },
        evidenceRefs: { $ref: "#/$defs/evidenceRefs" }
      }
    },
    issueCard: {
      type: "object",
      additionalProperties: false,
      required: [
        "issueRef",
        "kind",
        "severity",
        "status",
        "classification",
        "title",
        "summary",
        "evidenceRefs",
        "hypothesisRefs",
        "patch"
      ],
      properties: {
        issueRef: {
          $ref: "urn:production-monitoring:schema:common:1#/$defs/WorkbenchIssueRef"
        },
        kind: {
          enum: ["ALERT", "REGRESSION", "ANOMALY", "CONTRADICTION", "EVIDENCE_GAP"]
        },
        severity: { enum: ["INFO", "WARNING", "CRITICAL"] },
        status: { enum: ["OPEN", "SUPPORTED", "RESOLVED", "BLOCKED"] },
        classification: { enum: ["SIGNED_RULE", "DEVIATION"] },
        title: { type: "string", minLength: 1, maxLength: 128 },
        summary: { type: "string", minLength: 1, maxLength: 512 },
        evidenceRefs: { $ref: "#/$defs/evidenceRefs" },
        hypothesisRefs: {
          type: "array",
          maxItems: 8,
          uniqueItems: true,
          items: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Alias" }
        },
        patch: { $ref: "urn:production-monitoring:schema:patch-status:1" }
      },
      allOf: [
        {
          if: { properties: { kind: { const: "ANOMALY" } }, required: ["kind"] },
          then: { properties: { classification: { const: "SIGNED_RULE" } } }
        }
      ]
    },
    evidenceCard: {
      type: "object",
      additionalProperties: false,
      required: [
        "evidenceRef",
        "title",
        "domain",
        "state",
        "authority",
        "sourceLabel",
        "summary",
        "linkRefs"
      ],
      properties: {
        evidenceRef: {
          $ref: "urn:production-monitoring:schema:common:1#/$defs/WorkbenchEvidenceRef"
        },
        title: { type: "string", minLength: 1, maxLength: 128 },
        domain: {
          $ref: "urn:production-monitoring:schema:common:1#/$defs/EvidenceDomain"
        },
        state: { enum: ["COMPLETE", "EMPTY", "STALE", "CONTRADICTORY", "ERROR"] },
        authority: {
          $ref: "urn:production-monitoring:schema:common:1#/$defs/Authority"
        },
        sourceLabel: { type: "string", minLength: 1, maxLength: 96 },
        summary: { type: "string", minLength: 1, maxLength: 512 },
        observedAt: { type: "string", format: "date-time" },
        linkRefs: { $ref: "#/$defs/linkRefs" }
      }
    },
    activityItem: {
      type: "object",
      additionalProperties: false,
      required: ["activityRef", "at", "kind", "state", "title"],
      properties: {
        activityRef: { $ref: "urn:production-monitoring:schema:common:1#/$defs/Alias" },
        at: { type: "string", format: "date-time" },
        kind: {
          enum: ["READINESS", "SCOPE", "EVIDENCE", "ANALYSIS", "PATCH", "RECOVERY", "SYSTEM"]
        },
        state: { enum: ["PENDING", "RUNNING", "COMPLETE", "PARTIAL", "ERROR"] },
        title: { type: "string", minLength: 1, maxLength: 128 },
        detail: { type: "string", minLength: 1, maxLength: 512 }
      }
    },
    actionAvailability: {
      type: "object",
      additionalProperties: false,
      required: ["action", "enabled", "label"],
      properties: {
        action: {
          enum: [
            "NONE",
            "COLLECT_EVIDENCE",
            "RETRY_COLLECTION",
            "GENERATE_PATCH",
            "REVIEW_PATCH",
            "VERIFY_RECOVERY"
          ]
        },
        enabled: { type: "boolean" },
        label: { type: "string", minLength: 1, maxLength: 80 },
        reason: { type: "string", minLength: 1, maxLength: 256 }
      }
    }
  }
};

