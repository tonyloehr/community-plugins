{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:production-monitoring:schema:investigation:1",
  "title": "Evidence-linked investigation",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "runId", "analysisState", "status", "recoveryState", "scope", "requestedWindow", "evaluatedWindow", "observations", "inferences", "hypotheses", "contradictionIds", "checksPerformed", "missingEvidence", "smallestSafeNextStep", "approvalRequired", "remainingUncertainty", "owners", "integrity"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "runId": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/RunId" }, "analysisState": { "enum": ["SUBMITTED", "EVIDENCE_ONLY"] }, "status": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/InvestigationStatus" }, "recoveryState": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/RecoveryState" }, "scope": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Scope" }, "requestedWindow": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/TimeWindow" }, "evaluatedWindow": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/TimeWindow" },
    "observations": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/observation" } }, "inferences": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/inference" } }, "hypotheses": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/hypothesis" } }, "contradictionIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/ContradictionId" } },
    "checksPerformed": { "$ref": "#/$defs/stringList" }, "missingEvidence": { "$ref": "#/$defs/stringList" }, "smallestSafeNextStep": { "type": "string", "minLength": 1, "maxLength": 4096 }, "approvalRequired": { "type": "boolean" }, "verificationContract": { "$ref": "#/$defs/verificationContract" }, "verificationResult": { "type": "object", "additionalProperties": false, "required": ["status", "evidenceIds"], "properties": { "status": { "enum": ["PASSED", "FAILED", "INCOMPLETE"] }, "evidenceIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/EvidenceId" } } } }, "remainingUncertainty": { "$ref": "#/$defs/stringList" }, "owners": { "$ref": "#/$defs/stringList" }, "integrity": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Integrity" }
  },
  "$defs": {
    "stringList": { "type": "array", "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
    "evidenceIds": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/EvidenceId" } },
    "observation": { "type": "object", "additionalProperties": false, "required": ["observationId", "statement", "evidenceIds"], "properties": { "observationId": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Alias" }, "statement": { "type": "string", "minLength": 1, "maxLength": 4096 }, "evidenceIds": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/EvidenceId" } } } },
    "inference": { "type": "object", "additionalProperties": false, "required": ["inferenceId", "statement", "confidence", "rationale", "supportingEvidenceIds", "contradictingEvidenceIds"], "properties": { "inferenceId": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Alias" }, "statement": { "type": "string", "minLength": 1, "maxLength": 4096 }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "rationale": { "type": "string", "minLength": 1, "maxLength": 4096 }, "supportingEvidenceIds": { "$ref": "#/$defs/supportingEvidenceIds" }, "contradictingEvidenceIds": { "$ref": "#/$defs/evidenceIds" } } },
    "hypothesis": { "type": "object", "additionalProperties": false, "required": ["hypothesisId", "rank", "statement", "status", "rationale", "supportingEvidenceIds", "contradictingEvidenceIds"], "properties": { "hypothesisId": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Alias" }, "rank": { "type": "integer", "minimum": 1 }, "statement": { "type": "string", "minLength": 1, "maxLength": 4096 }, "status": { "enum": ["OPEN", "SUPPORTED", "WEAKENED", "REJECTED"] }, "rationale": { "type": "string", "minLength": 1, "maxLength": 4096 }, "supportingEvidenceIds": { "$ref": "#/$defs/supportingEvidenceIds" }, "contradictingEvidenceIds": { "$ref": "#/$defs/evidenceIds" }, "nextCheck": { "type": "string", "minLength": 1, "maxLength": 4096 } } },
    "verificationContract": { "type": "object", "additionalProperties": false, "required": ["contractSha256", "policyAlias", "scope", "windowStrategy", "windowDurationSeconds", "requiredSamples", "passCount", "criteria"], "properties": { "contractSha256": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Sha256" }, "policyAlias": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Alias" }, "scope": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Scope" }, "cohort": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Alias" }, "windowStrategy": { "enum": ["FIXED", "ROLLING", "REPEATED_CHECKS"] }, "windowDurationSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 }, "requiredSamples": { "type": "integer", "minimum": 1, "maximum": 10000 }, "passCount": { "type": "integer", "minimum": 1, "maximum": 10000 }, "criteria": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "object", "additionalProperties": false, "required": ["criterionId", "operationId", "operationDefinitionSha256", "valueSelector", "comparator", "expected", "maxEvidenceAgeMs"], "properties": { "criterionId": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Alias" }, "operationId": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/OperationId" }, "operationDefinitionSha256": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Sha256" }, "valueSelector": { "type": "object", "additionalProperties": false, "required": ["kind", "name", "reducer"], "properties": { "kind": { "enum": ["SCALAR", "TIMESERIES"] }, "name": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Alias" }, "reducer": { "enum": ["SINGLE", "LATEST", "ALL"] }, "dimensions": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Dimensions" } } }, "comparator": { "enum": ["LT", "LTE", "GT", "GTE", "EQ", "INACTIVE", "ACTIVE"] }, "expected": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/JsonPrimitive" }, "unit": { "type": "string", "minLength": 1, "maxLength": 64 }, "maxEvidenceAgeMs": { "type": "integer", "minimum": 0, "maximum": 31536000000 }, "requiredDurationSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 } } } } } },
    "supportingEvidenceIds": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/EvidenceId" } }
  },
  "allOf": [{ "if": { "properties": { "recoveryState": { "const": "RECOVERED" } }, "required": ["recoveryState"] }, "then": { "required": ["verificationContract", "verificationResult"], "properties": { "verificationContract": { "$ref": "#/$defs/verificationContract" }, "verificationResult": { "type": "object", "properties": { "status": { "const": "PASSED" } }, "required": ["status"] } } } }]
}
