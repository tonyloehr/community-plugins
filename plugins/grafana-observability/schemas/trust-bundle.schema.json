{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:production-monitoring:schema:trust-bundle:1",
  "title": "Pinned trust bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "createdAt", "profile", "endpoints", "operations", "adapters", "integrity"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "createdAt": { "type": "string", "format": "date-time" },
    "profile": { "$ref": "urn:production-monitoring:schema:trusted-profile:1" },
    "endpoints": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/endpoint" } },
    "operations": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:production-monitoring:schema:operation-snapshot:1" } },
    "capabilityPacks": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "urn:production-monitoring:schema:provider-capability-pack:1" }
    },
    "adapters": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:production-monitoring:schema:adapter-package:1" } },
    "integrity": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Integrity" }
  },
  "$defs": {
    "credential": { "type": "object", "additionalProperties": false, "required": ["kind", "key"], "properties": { "kind": { "enum": ["env", "workload_identity", "broker"] }, "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$" } } },
    "authentication": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "NONE" } } },
        { "type": "object", "additionalProperties": false, "required": ["mode", "tokenRef"], "properties": { "mode": { "const": "BEARER" }, "tokenRef": { "$ref": "#/$defs/credential" } } },
        { "type": "object", "additionalProperties": false, "required": ["mode", "usernameRef", "passwordRef"], "properties": { "mode": { "const": "BASIC" }, "usernameRef": { "$ref": "#/$defs/credential" }, "passwordRef": { "$ref": "#/$defs/credential" } } },
        { "type": "object", "additionalProperties": false, "required": ["mode", "certificateRef", "privateKeyRef"], "properties": { "mode": { "const": "MTLS" }, "certificateRef": { "$ref": "#/$defs/credential" }, "privateKeyRef": { "$ref": "#/$defs/credential" } } }
      ]
    },
    "endpoint": {
      "type": "object", "additionalProperties": false, "required": ["endpointId", "adapterId", "baseUrl", "authentication", "tls", "network"],
      "properties": {
        "endpointId": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Alias" }, "adapterId": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Alias" }, "baseUrl": { "type": "string", "format": "uri" }, "authentication": { "$ref": "#/$defs/authentication" },
        "tls": { "type": "object", "additionalProperties": false, "required": ["minimumVersion"], "properties": { "minimumVersion": { "enum": ["TLSv1.2", "TLSv1.3"] }, "caRef": { "$ref": "#/$defs/credential" }, "serverName": { "type": "string", "minLength": 1, "maxLength": 253 } } },
        "network": { "type": "object", "additionalProperties": false, "required": ["followRedirects", "allowLoopbackHttp", "allowedHosts", "networkClass", "routeMode"], "properties": { "followRedirects": { "const": false }, "allowLoopbackHttp": { "type": "boolean" }, "allowedHosts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 253 } }, "networkClass": { "enum": ["loopback", "private", "public"] }, "routeMode": { "enum": ["direct", "host_vpn", "application_proxy"] } } },
        "tenantBinding": { "type": "object", "additionalProperties": false, "required": ["headerName", "valueRef"], "properties": { "headerName": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,128}$" }, "valueRef": { "type": "string", "pattern": "^metadata:[A-Za-z][A-Za-z0-9_.-]{0,127}$" } } }
      }
    }
  },
  "$comment": "integrity.contentSha256 covers RFC 8785 UTF-8 bytes for the complete object with the top-level integrity member omitted."
}
