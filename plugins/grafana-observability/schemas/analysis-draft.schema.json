{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:production-monitoring:schema:analysis-draft:1",
  "title": "Production Monitoring analysis draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "observations", "inferences", "hypotheses", "checksPerformed", "missingEvidence", "smallestSafeNextStep", "approvalRequired", "remainingUncertainty", "owners"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "observations": { "type": "array", "maxItems": 1000, "items": { "$ref": "urn:production-monitoring:schema:investigation:1#/$defs/observation" } },
    "inferences": { "type": "array", "maxItems": 1000, "items": { "$ref": "urn:production-monitoring:schema:investigation:1#/$defs/inference" } },
    "hypotheses": { "type": "array", "maxItems": 256, "items": { "$ref": "urn:production-monitoring:schema:investigation:1#/$defs/hypothesis" } },
    "checksPerformed": { "$ref": "urn:production-monitoring:schema:investigation:1#/$defs/stringList" },
    "missingEvidence": { "$ref": "urn:production-monitoring:schema:investigation:1#/$defs/stringList" },
    "smallestSafeNextStep": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "approvalRequired": { "type": "boolean" },
    "remainingUncertainty": { "$ref": "urn:production-monitoring:schema:investigation:1#/$defs/stringList" },
    "owners": { "$ref": "urn:production-monitoring:schema:investigation:1#/$defs/stringList" }
  }
}
