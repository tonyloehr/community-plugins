{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:production-monitoring:schema:trusted-profile:1",
  "title": "Compiled trusted monitoring profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileAlias", "capabilityProfile", "allowedOrigins", "compiledAt", "configSha256", "endpointRegistrySha256", "catalogSha256", "scopes", "endpointIds", "operationIds", "policy"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "profileAlias": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Alias" },
    "capabilityProfile": { "enum": ["observe", "investigate", "prepare_patch"] },
    "allowedOrigins": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Origin" } },
    "compiledAt": { "type": "string", "format": "date-time" },
    "configSha256": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Sha256" },
    "endpointRegistrySha256": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Sha256" },
    "catalogSha256": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Sha256" },
    "scopes": { "type": "object", "minProperties": 1, "propertyNames": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Alias" }, "additionalProperties": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Scope" } },
    "endpointIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Alias" } },
    "operationIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/OperationId" } },
    "capabilityPackIds": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/CapabilityPackId" }
    },
    "capabilityPackCatalogSha256": {
      "$ref": "urn:production-monitoring:schema:common:1#/$defs/Sha256"
    },
    "defaultVerificationPolicyAlias": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Alias" },
    "verificationPolicies": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Alias" },
      "additionalProperties": { "$ref": "#/$defs/verificationPolicy" }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["defaultLookback", "maxEvidenceAge", "rawEvidenceRetention", "auditRequired", "limits"],
      "properties": {
        "defaultLookback": { "$ref": "#/$defs/operatorSetting" },
        "maxEvidenceAge": { "$ref": "#/$defs/operatorSetting" },
        "rawEvidenceRetention": { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "NONE" } }, "$comment": "The current core normalizes provider responses and never persists the opaque provider payload." },
        "auditRequired": { "type": "boolean" },
        "limits": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/OperationLimits" }
      }
    }
  },
  "$defs": {
    "operatorSetting": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "OPERATOR_REQUIRED" } } }, { "type": "object", "additionalProperties": false, "required": ["mode", "durationSeconds"], "properties": { "mode": { "const": "FIXED" }, "durationSeconds": { "type": "integer", "minimum": 1, "maximum": 31536000 } } }] },
    "valueSelector": { "type": "object", "additionalProperties": false, "required": ["kind", "name", "reducer"], "properties": { "kind": { "enum": ["SCALAR", "TIMESERIES"] }, "name": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Alias" }, "reducer": { "enum": ["SINGLE", "LATEST", "ALL"] }, "dimensions": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Dimensions" } } },
    "verificationCriterion": { "type": "object", "additionalProperties": false, "required": ["criterionId", "operationId", "valueSelector", "comparator", "expected", "maxEvidenceAgeMs"], "properties": { "criterionId": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Alias" }, "operationId": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/OperationId" }, "valueSelector": { "$ref": "#/$defs/valueSelector" }, "comparator": { "enum": ["LT", "LTE", "GT", "GTE", "EQ", "INACTIVE", "ACTIVE"] }, "expected": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/JsonPrimitive" }, "unit": { "type": "string", "minLength": 1, "maxLength": 64 }, "maxEvidenceAgeMs": { "type": "integer", "minimum": 0, "maximum": 31536000000 }, "requiredDurationSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 } } },
    "verificationPolicy": { "type": "object", "additionalProperties": false, "required": ["policyAlias", "windowStrategy", "windowDurationSeconds", "requiredSamples", "passCount", "criteria"], "properties": { "policyAlias": { "$ref": "urn:production-monitoring:schema:common:1#/$defs/Alias" }, "windowStrategy": { "enum": ["FIXED", "ROLLING", "REPEATED_CHECKS"] }, "windowDurationSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 }, "requiredSamples": { "type": "integer", "minimum": 1, "maximum": 10000 }, "passCount": { "type": "integer", "minimum": 1, "maximum": 10000 }, "criteria": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/verificationCriterion" } } } }
  }
}
