{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:production-monitoring:schema:patch-status:1",
  "title": "Workbench patch status projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "state",
    "eligible",
    "updatedAt",
    "evidenceRefs",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "state": {
      "enum": [
        "NOT_ELIGIBLE",
        "ELIGIBLE",
        "REQUESTED",
        "HANDOFF_COMPLETE",
        "BLOCKED",
        "STALE"
      ]
    },
    "eligible": { "type": "boolean" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:production-monitoring:schema:common:1#/$defs/WorkbenchEvidenceRef"
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  }
}
