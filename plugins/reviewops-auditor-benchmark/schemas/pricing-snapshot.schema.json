{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reviewops:schema:pricing-snapshot:1",
  "title": "ReviewOps user-supplied pricing snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "currency",
    "effectiveAt",
    "costBasis",
    "provenance",
    "rates"
  ],
  "properties": {
    "schemaVersion": { "$ref": "urn:reviewops:schema:common:1#/$defs/SchemaVersion" },
    "snapshotId": { "$ref": "urn:reviewops:schema:common:1#/$defs/PublicAlias" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "effectiveAt": { "$ref": "urn:reviewops:schema:common:1#/$defs/UtcTimestamp" },
    "costBasis": { "$ref": "urn:reviewops:schema:common:1#/$defs/CostBasis" },
    "provenance": { "$ref": "urn:reviewops:schema:common:1#/$defs/Provenance" },
    "rates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variantId",
          "inputMicrosPerMillion",
          "cachedInputMicrosPerMillion",
          "outputMicrosPerMillion",
          "toolingMicrosPerRun",
          "humanReviewMicrosPerMinute"
        ],
        "properties": {
          "variantId": { "$ref": "urn:reviewops:schema:common:1#/$defs/PublicAlias" },
          "inputMicrosPerMillion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000000
          },
          "cachedInputMicrosPerMillion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000000
          },
          "outputMicrosPerMillion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000000
          },
          "toolingMicrosPerRun": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000000
          },
          "humanReviewMicrosPerMinute": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000000
          }
        }
      }
    }
  }
}
