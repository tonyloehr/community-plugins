{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reviewops:schema:eval-protocol:1",
  "title": "ReviewOps evaluation protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolId",
    "protocolVersion",
    "laneId",
    "intendedClaim",
    "samplingFrame",
    "cohortSelectionDigest",
    "cohortWindowId",
    "inclusionPolicyId",
    "exclusionPolicyId",
    "assignmentMethod",
    "pairingMethod",
    "replicateAggregation",
    "missingReplicatePolicy",
    "leakageControls",
    "knownContamination",
    "heldConstantFields",
    "preservationContracts",
    "expectedExecutionMode",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "$ref": "urn:reviewops:schema:common:1#/$defs/SchemaVersion" },
    "protocolId": { "$ref": "urn:reviewops:schema:common:1#/$defs/PublicAlias" },
    "protocolVersion": { "$ref": "urn:reviewops:schema:common:1#/$defs/PublicAlias" },
    "laneId": { "$ref": "urn:reviewops:schema:common:1#/$defs/PublicAlias" },
    "intendedClaim": {
      "enum": ["MODEL_ONLY", "ONE_FACTOR", "HOLISTIC_SYSTEM", "SHADOW_NO_POSTING"]
    },
    "samplingFrame": { "$ref": "urn:reviewops:schema:common:1#/$defs/PublicAlias" },
    "cohortSelectionDigest": { "$ref": "urn:reviewops:schema:common:1#/$defs/Digest" },
    "cohortWindowId": { "$ref": "urn:reviewops:schema:common:1#/$defs/OpaqueDigestId" },
    "inclusionPolicyId": { "$ref": "urn:reviewops:schema:common:1#/$defs/PublicAlias" },
    "exclusionPolicyId": { "$ref": "urn:reviewops:schema:common:1#/$defs/PublicAlias" },
    "assignmentMethod": {
      "enum": ["PAIRED_SAME_CASE", "RANDOMIZED_BLOCKED", "UNKNOWN"]
    },
    "pairingMethod": {
      "enum": ["CASE_VARIANT", "CASE_VARIANT_REPLICATE", "UNKNOWN"]
    },
    "replicateAggregation": { "const": "CASE_PRIMITIVES" },
    "missingReplicatePolicy": {
      "enum": ["BLOCK", "SYMMETRIC_EXCLUDE_CASE"]
    },
    "predeclaredExclusions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "symmetric", "provenanceDigest"],
        "properties": {
          "caseId": {
            "$ref": "urn:reviewops:schema:common:1#/$defs/OpaqueDigestId"
          },
          "symmetric": { "const": true },
          "provenanceDigest": {
            "$ref": "urn:reviewops:schema:common:1#/$defs/Digest"
          }
        }
      }
    },
    "leakageControls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["controlId", "status", "evidenceStatus"],
        "properties": {
          "controlId": { "$ref": "urn:reviewops:schema:common:1#/$defs/PublicAlias" },
          "status": { "enum": ["DECLARED", "FAILED", "UNKNOWN"] },
          "evidenceStatus": {
            "$ref": "urn:reviewops:schema:common:1#/$defs/DeclarationStatus"
          }
        }
      }
    },
    "knownContamination": { "enum": ["NONE_DECLARED", "PRESENT", "UNKNOWN"] },
    "heldConstantFields": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "urn:reviewops:schema:common:1#/$defs/DifferenceAxis" }
    },
    "preservationContracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controllerContractId",
        "validatorContractId",
        "dedupePolicyId",
        "postingPolicyId",
        "toolContractId",
        "contextClass",
        "retryPolicyId",
        "timeoutPolicyId",
        "routingPolicyId"
      ],
      "properties": {
        "controllerContractId": {
          "$ref": "urn:reviewops:schema:common:1#/$defs/PublicAlias"
        },
        "validatorContractId": {
          "$ref": "urn:reviewops:schema:common:1#/$defs/PublicAlias"
        },
        "dedupePolicyId": {
          "$ref": "urn:reviewops:schema:common:1#/$defs/PublicAlias"
        },
        "postingPolicyId": {
          "$ref": "urn:reviewops:schema:common:1#/$defs/PublicAlias"
        },
        "toolContractId": {
          "$ref": "urn:reviewops:schema:common:1#/$defs/PublicAlias"
        },
        "contextClass": { "$ref": "urn:reviewops:schema:common:1#/$defs/PublicAlias" },
        "retryPolicyId": { "$ref": "urn:reviewops:schema:common:1#/$defs/PublicAlias" },
        "timeoutPolicyId": {
          "$ref": "urn:reviewops:schema:common:1#/$defs/PublicAlias"
        },
        "routingPolicyId": {
          "$ref": "urn:reviewops:schema:common:1#/$defs/PublicAlias"
        }
      }
    },
    "expectedExecutionMode": {
      "$ref": "urn:reviewops:schema:common:1#/$defs/ExecutionMode"
    },
    "provenance": { "$ref": "urn:reviewops:schema:common:1#/$defs/Provenance" }
  },
  "allOf": [
    {
      "if": {
        "required": ["predeclaredExclusions"],
        "properties": {
          "predeclaredExclusions": { "type": "array", "minItems": 1 }
        }
      },
      "then": {
        "properties": {
          "missingReplicatePolicy": { "const": "SYMMETRIC_EXCLUDE_CASE" }
        }
      }
    }
  ]
}
