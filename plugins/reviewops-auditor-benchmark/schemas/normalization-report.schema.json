{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reviewops:schema:normalization-report:1",
  "title": "ReviewOps bounded normalization report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolVersion",
    "analysisAsOf",
    "configDigest",
    "status",
    "inputDigests",
    "appliedLimits",
    "redactionCounts",
    "warnings",
    "claimBoundary",
    "bundles",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "$ref": "urn:reviewops:schema:common:1#/$defs/SchemaVersion" },
    "toolVersion": { "$ref": "urn:reviewops:schema:common:1#/$defs/ToolVersion" },
    "analysisAsOf": { "$ref": "urn:reviewops:schema:common:1#/$defs/UtcTimestamp" },
    "configDigest": { "$ref": "urn:reviewops:schema:common:1#/$defs/Digest" },
    "status": { "$ref": "urn:reviewops:schema:common:1#/$defs/Status" },
    "inputDigests": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "urn:reviewops:schema:common:1#/$defs/InputDigest" }
    },
    "appliedLimits": { "$ref": "urn:reviewops:schema:common:1#/$defs/AppliedLimits" },
    "redactionCounts": {
      "$ref": "urn:reviewops:schema:common:1#/$defs/RedactionCounts"
    },
    "warnings": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "urn:reviewops:schema:common:1#/$defs/Warning" }
    },
    "claimBoundary": { "$ref": "urn:reviewops:schema:common:1#/$defs/SafeText" },
    "bundles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bundleId",
          "sourceMode",
          "status",
          "sourceRecordCount",
          "acceptedRecordCount",
          "rejectedRecordCount",
          "duplicateRecordCount",
          "normalizedRecordCount",
          "exporterVersions",
          "reasonCodes",
          "receipts"
        ],
        "properties": {
          "bundleId": { "$ref": "urn:reviewops:schema:common:1#/$defs/PublicAlias" },
          "sourceMode": { "$ref": "urn:reviewops:schema:common:1#/$defs/SourceMode" },
          "status": { "$ref": "urn:reviewops:schema:common:1#/$defs/Status" },
          "sourceRecordCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "acceptedRecordCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "rejectedRecordCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "duplicateRecordCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "normalizedRecordCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "exporterVersions": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "$ref": "urn:reviewops:schema:common:1#/$defs/ToolVersion"
            }
          },
          "reasonCodes": {
            "$ref": "urn:reviewops:schema:common:1#/$defs/SafeTextArray"
          },
          "receipts": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "$ref": "urn:reviewops:schema:common:1#/$defs/StructuralReceipt"
            }
          }
        }
      }
    },
    "limitations": { "$ref": "urn:reviewops:schema:common:1#/$defs/SafeTextArray" },
    "error": { "$ref": "urn:reviewops:schema:common:1#/$defs/SanitizedError" }
  }
}
