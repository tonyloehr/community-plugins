{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reviewops:schema:eval-validity-report:1",
  "title": "ReviewOps evaluation-validity report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolVersion",
    "analysisAsOf",
    "configDigest",
    "status",
    "inputDigests",
    "appliedLimits",
    "redactionCounts",
    "warnings",
    "claimBoundary",
    "lanes",
    "staticDiagnosticContext",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "$ref": "urn:reviewops:schema:common:1#/$defs/SchemaVersion" },
    "toolVersion": { "$ref": "urn:reviewops:schema:common:1#/$defs/ToolVersion" },
    "analysisAsOf": { "$ref": "urn:reviewops:schema:common:1#/$defs/UtcTimestamp" },
    "configDigest": { "$ref": "urn:reviewops:schema:common:1#/$defs/Digest" },
    "status": { "$ref": "urn:reviewops:schema:common:1#/$defs/Status" },
    "inputDigests": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "urn:reviewops:schema:common:1#/$defs/InputDigest" }
    },
    "appliedLimits": { "$ref": "urn:reviewops:schema:common:1#/$defs/AppliedLimits" },
    "redactionCounts": {
      "$ref": "urn:reviewops:schema:common:1#/$defs/RedactionCounts"
    },
    "warnings": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "urn:reviewops:schema:common:1#/$defs/Warning" }
    },
    "claimBoundary": { "$ref": "urn:reviewops:schema:common:1#/$defs/SafeText" },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bundleId",
          "laneId",
          "laneType",
          "status",
          "attributionStatus",
          "claimBoundary",
          "reasonCodes",
          "pairedCaseCount",
          "pairingCoverage",
          "heldConstantDimensions",
          "intentionallyChangedDimensions",
          "unexpectedDimensions",
          "missingDimensions",
          "checks",
          "exclusions",
          "evidenceRequired",
          "limitations"
        ],
        "properties": {
          "bundleId": { "$ref": "urn:reviewops:schema:common:1#/$defs/PublicAlias" },
          "laneId": { "$ref": "urn:reviewops:schema:common:1#/$defs/PublicAlias" },
          "laneType": { "$ref": "urn:reviewops:schema:common:1#/$defs/LaneType" },
          "status": { "$ref": "urn:reviewops:schema:common:1#/$defs/Status" },
          "attributionStatus": {
            "$ref": "urn:reviewops:schema:common:1#/$defs/AttributionStatus"
          },
          "claimBoundary": { "$ref": "urn:reviewops:schema:common:1#/$defs/SafeText" },
          "reasonCodes": {
            "$ref": "urn:reviewops:schema:common:1#/$defs/SafeTextArray"
          },
          "pairedCaseCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "pairingCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
          "heldConstantDimensions": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "$ref": "urn:reviewops:schema:common:1#/$defs/DifferenceAxis"
            }
          },
          "intentionallyChangedDimensions": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "$ref": "urn:reviewops:schema:common:1#/$defs/DifferenceAxis"
            }
          },
          "unexpectedDimensions": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "$ref": "urn:reviewops:schema:common:1#/$defs/DifferenceAxis"
            }
          },
          "missingDimensions": {
            "$ref": "urn:reviewops:schema:common:1#/$defs/SafeTextArray"
          },
          "checks": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ruleId", "status", "reason", "evidenceStatus"],
              "properties": {
                "ruleId": { "type": "string", "pattern": "^RO-EV-[0-9]{3}$" },
                "status": { "$ref": "urn:reviewops:schema:common:1#/$defs/GateStatus" },
                "reason": { "$ref": "urn:reviewops:schema:common:1#/$defs/SafeText" },
                "evidenceStatus": {
                  "$ref": "urn:reviewops:schema:common:1#/$defs/DeclarationStatus"
                }
              }
            }
          },
          "exclusions": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["caseId", "reasonCodes"],
              "properties": {
                "caseId": {
                  "$ref": "urn:reviewops:schema:common:1#/$defs/OpaqueDigestId"
                },
                "reasonCodes": {
                  "$ref": "urn:reviewops:schema:common:1#/$defs/SafeTextArray"
                }
              }
            }
          },
          "evidenceRequired": {
            "$ref": "urn:reviewops:schema:common:1#/$defs/SafeTextArray"
          },
          "limitations": {
            "$ref": "urn:reviewops:schema:common:1#/$defs/SafeTextArray"
          }
        }
      }
    },
    "staticDiagnosticContext": { "enum": ["NOT_SUPPLIED", "SUPPLIED"] },
    "staticDiagnostics": { "$ref": "urn:reviewops:schema:static-diagnostic-report:1" },
    "limitations": { "$ref": "urn:reviewops:schema:common:1#/$defs/SafeTextArray" },
    "error": { "$ref": "urn:reviewops:schema:common:1#/$defs/SanitizedError" }
  }
}
