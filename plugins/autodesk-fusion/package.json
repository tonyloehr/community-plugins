{
  "name": "@community-plugins/autodesk-fusion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "description": "Codex interoperability with Autodesk Fusion desktop, native MCP and APS services.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:native": "node scripts/build-native.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:python": "node scripts/test-python.mjs",
    "test:live": "node scripts/fusionctl.mjs qualify --live",
    "test:vault": "node --test --test-concurrency=1 tests/native-credentials.test.mjs",
    "evaluate:workflows": "node scripts/evaluate-workflows.mjs",
    "benchmark:local": "node scripts/benchmark-local.mjs",
    "verify": "npm run build && npm run typecheck && npm test && npm run test:python"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
